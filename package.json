{
  "name": "support-library",
  "version": "1.0.1",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "next dev -p 12000",
    "build": "next build",
    "start": "next start -p 12000",
    "start:standalone": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:watch:e2e": "playwright test --ui",
    "db:indexes": "tsx scripts/sync-indexes.ts",
    "db:preflight": "tsx scripts/production-db-preflight.ts",
    "db:migrate-issue-visibility": "tsx scripts/migrate-issue-visibility.ts",
    "db:purge-internal-notes": "tsx scripts/purge-internal-notes.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:hash-student-emails": "tsx scripts/hash-student-emails.ts",
    "clean:e2e-artifacts": "tsx scripts/clean-e2e-artifacts.ts",
    "bench:search": "tsx scripts/bench-search.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "dotenv": "18.0.7",
    "framer-motion": "^14.1.0",
    "mongodb": "^6.21.0",
    "mongoose": "8.24.5",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "braces": "^3.0.3"
  }
}
