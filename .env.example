# Hablu Support Library — environment example
# Copy to .env.local and fill real values.
# NEVER commit real secrets. (.env / .env*.local are gitignored; .env.example IS committed.)

# --- MongoDB ---
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=hablu_support_library

# --- Auth.js v5 (reads AUTH_* automatically; do NOT use NEXTAUTH_* here) ---
# Generate with: npx auth secret
AUTH_SECRET=
# Set true when running behind a proxy (Vercel / nginx / Cloudflare).
AUTH_TRUST_HOST=true
# Public origin; used to build the OAuth callback URL in local dev.
AUTH_URL=http://localhost:3000
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Staff access control ---
# Comma-separated. Exact emails or @domain entries. Anyone outside this list
# is rejected in the Auth.js signIn callback.
STAFF_EMAIL_ALLOWLIST=owner@hablu-programmer.com,mentor@hablu-programmer.com
# This exact email is promoted to ADMIN on first sign-in.
INITIAL_ADMIN_EMAIL=owner@hablu-programmer.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development