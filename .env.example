# Hablu Support Library — environment example
# Copy to .env.local and fill real values.
# NEVER commit real secrets. (.env / .env*.local are gitignored; .env.example IS committed.)

# --- MongoDB ---
# Support writes run inside transactions, which require a replica set. For local
# development start MongoDB as a single-node replica set, e.g.:
#   docker run --name mongo-rs -p 27017:27017 mongo:8.0 --replSet rs0 --bind_ip_all
#   docker exec mongo-rs mongosh --eval 'rs.initiate({_id:"rs0",members:[{_id:0,host:"127.0.0.1:27017"}]})'
# then use: mongodb://127.0.0.1:27017/?replicaSet=rs0
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=hablu_support_library
MONGODB_TEST_DB=hablu_support_library_test
E2E_ALLOW_DATABASE_RESET=false
# Use a separate Atlas user that has read-only access to hp-v2.
# Local/test environments may omit this and reuse MONGODB_URI.
LMS_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Read-only database that holds the real user accounts (roles, isActive).
# Users are looked up here to allow login and to derive ADMIN/MENTOR/VIEWER.
LMS_MONGODB_DB=hp-v2

# --- Auth.js v5 (reads AUTH_* automatically; do NOT use NEXTAUTH_* here) ---
# Generate with: npx auth secret
AUTH_SECRET=
# Set true when running behind a proxy (Vercel / nginx / Cloudflare).
AUTH_TRUST_HOST=true
# Canonical public origin. Production must use HTTPS.
AUTH_URL=http://localhost:12000
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# Authorized redirect URI: http://localhost:12000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:12000
NODE_ENV=development

# --- External link policy (MVP stores links only; no uploads) ---
ALLOW_INSECURE_LINKS=false
# Optional comma-separated host allowlist. Leave empty to allow any HTTPS host.
ALLOWED_LINK_HOSTS=
MAX_LINKS_PER_ITEM=10

# --- Seed/admin scripts ---
SEED_ADMIN_EMAIL=owner@hablu-programmer.com
SEED_ADMIN_NAME=Hablu Admin
