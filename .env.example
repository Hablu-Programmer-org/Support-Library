# Hablu Support Library — environment example
# Copy to .env.local and fill real values.
# NEVER commit real secrets. (.env / .env*.local are gitignored; .env.example IS committed.)

# --- MongoDB ---
# Support writes run inside transactions, which require a replica set. For local
# development start MongoDB as a single-node replica set, e.g.:
#   docker run --name mongo-rs -p 27017:27017 mongo:8.0 --replSet rs0 --bind_ip_all
#   docker exec mongo-rs mongosh --eval 'rs.initiate({_id:"rs0",members:[{_id:0,host:"127.0.0.1:27017"}]})'
# then use: mongodb://127.0.0.1:27017/?replicaSet=rs0
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=hablu_support_library
MONGODB_TEST_DB=hablu_support_library_test
E2E_ALLOW_DATABASE_RESET=false
# Use a separate Atlas user that has read-only access to hp-v2.
# Local/test environments may omit this and reuse MONGODB_URI.
LMS_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Read-only database that holds the real user accounts (roles, isActive).
# Users are looked up here to allow login and to derive ADMIN/MENTOR/STUDENT.
LMS_MONGODB_DB=hp-v2

# --- Student email encryption ---
# REQUIRED in every environment: the app refuses to start without a valid keyring
# here (every issue create encrypts the student email).
# Generate each independent 32-byte key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keyrings use comma-separated vN:<32-byte-base64> entries. Keep old encryption
# keys during rotation so existing records remain decryptable.
# Replace the empty placeholders below before running the app.
STUDENT_EMAIL_KEY_VERSION=v1
STUDENT_EMAIL_ENCRYPTION_KEYS=v1:
STUDENT_EMAIL_LOOKUP_KEYS=v1:

# --- Auth.js v5 (reads AUTH_* automatically; do NOT use NEXTAUTH_* here) ---
# Generate with: npx auth secret
AUTH_SECRET=
# Set true when running behind a proxy (Vercel / nginx / Cloudflare).
AUTH_TRUST_HOST=true
# Number of trusted reverse proxies nearest the app. Traefik directly in front
# of this container is one hop; production startup rejects zero/missing hops.
TRUSTED_PROXY_HOPS=1
# Canonical public origin. Production must use HTTPS.
AUTH_URL=http://localhost:12000
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# Authorized redirect URI: http://localhost:12000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:12000
NODE_ENV=development

# --- Server Actions ---
# Comma-separated list of allowed origins for Server Actions (required for cross-origin requests)
ALLOWED_ORIGINS=localhost:12000

# --- External link policy ---
# Optional comma-separated host allowlist. Leave empty to allow any HTTPS host.
ALLOWED_LINK_HOSTS=
# Max video links on an issue or reply. Range 1-50;
# missing or invalid values fall back to 10 (the hard ceiling is always 50).
MAX_LINKS_PER_ITEM=10

# --- Uploaded screenshots ---
# Images only (PNG/JPEG/GIF/WebP), stored in a private backend. Nothing is served
# straight from the store; downloads go through /api/attachments/<id>.
#
# UPLOAD_STORAGE unset -> `disabled` in production, `memory` in development.
# Select one backend. For the simplest no-card production setup, use `cloudinary`.
# UPLOAD_STORAGE=disabled
# UPLOAD_STORAGE=memory
# UPLOAD_STORAGE=r2
# UPLOAD_STORAGE=cloudinary
# UPLOAD_STORAGE_ALLOW_EPHEMERAL=false  # only with memory in production (E2E/preview)
#
# R2 (Cloudflare, requires a payment method on the account):
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#
# Cloudinary (free plan needs no card). Copy all three credentials from the
# Cloudinary Console -> Product Environment Credentials / API Keys:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Cloudinary Free accepts images up to 10 MiB and 25 MP. Leave the app default
# (5 MiB) in place. Only a plan that really supports larger files may set both a
# larger MAX_UPLOAD_BYTES and this explicit acknowledgement:
# CLOUDINARY_ALLOW_FILE_SIZE_OVER_10_MIB=false
# Never commit the API secret in a real env file.
# Max images per issue or reply (1-10, default 3, hard ceiling 10).
MAX_UPLOADS_PER_ITEM=3
# Max size of one uploaded image (1 KiB-25 MiB, default 5 MiB).
MAX_UPLOAD_BYTES=5242880

# --- Seed/admin scripts ---
SEED_ADMIN_EMAIL=owner@hablu-programmer.com
SEED_ADMIN_NAME=Hablu Admin
